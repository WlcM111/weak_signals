{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_manifest.schema.json",
  "title": "Манифест артефакта модели (trainer → model-store → analyzer)",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_version_id", "model_family", "feature_schema_version", "embedding_model", "dataset_version", "artifact_files", "threshold", "metrics", "trained_at", "git_commit", "stage_model_present", "trend_model_present"],
  "properties": {
    "model_version_id": {"type": "string", "pattern": "^wsclf-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]+$"},
    "model_family": {"type": "string", "enum": ["logreg_elasticnet", "lightgbm"]},
    "feature_schema_version": {"type": "string", "const": "v1"},
    "embedding_model": {"type": "string"},
    "dataset_version": {"type": "string", "pattern": "^ds-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-v[0-9]+$"},
    "artifact_files": {
      "type": "object", "additionalProperties": false,
      "required": ["classifier", "scaler", "calibrator", "centroids", "sha256"],
      "properties": {
        "classifier": {"type": "string"}, "scaler": {"type": "string"}, "calibrator": {"type": "string"}, "centroids": {"type": "string"},
        "stage_model": {"type": "string"}, "trend_model": {"type": "string"},
        "sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["test", "cv"],
      "properties": {
        "test": {"type": "object", "required": ["accuracy", "precision", "recall", "f1", "roc_auc", "n"], "properties": {"accuracy": {"type": "number"}, "precision": {"type": "number"}, "recall": {"type": "number"}, "f1": {"type": "number"}, "roc_auc": {"type": "number"}, "n": {"type": "integer"}}},
        "cv": {"type": "object", "required": ["protocol", "f1_mean", "f1_std", "accuracy_mean", "accuracy_std"], "properties": {"protocol": {"type": "string"}, "f1_mean": {"type": "number"}, "f1_std": {"type": "number"}, "accuracy_mean": {"type": "number"}, "accuracy_std": {"type": "number"}}}
      }
    },
    "trained_at": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string"},
    "stage_model_present": {"type": "boolean"},
    "trend_model_present": {"type": "boolean"}
  }
}
