{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "maturity_v2: возраст задачи и вид новизны кандидата (этап 5.4, второй проход зрелости)",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title_echo", "task_en", "task_since_year", "task_established", "novelty_type"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 16},
          "title_echo": {"type": "string", "minLength": 1, "maxLength": 200},
          "task_en": {"type": "string", "minLength": 2, "maxLength": 80},
          "task_since_year": {"type": "integer", "minimum": 0, "maximum": 2026},
          "task_established": {"type": "boolean"},
          "novelty_type": {"type": "string", "enum": ["new_mechanism", "new_application", "improvement", "survey", "news"]}
        }
      }
    }
  }
}
