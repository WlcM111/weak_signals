{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expand_llm_output.schema.json",
  "title": "Структурированный ответ LLM для ExpandQuery (prompt expand_v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["ru_terms", "en_terms", "domain_tags"],
  "properties": {
    "ru_terms": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
    "en_terms": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
    "domain_tags": {"type": "array", "maxItems": 5, "items": {"type": "string", "enum": ["industrial_ai", "robotics", "ai_infrastructure", "fintech", "ai_security", "edge", "other"]}}
  }
}
