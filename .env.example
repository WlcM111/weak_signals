# Скопируйте этот файл в .env и заполните значения. Секреты в репозиторий не коммитятся (.gitignore: .env).
#
# ВАЖНО: комментарии пишутся ТОЛЬКО на отдельных строках, как здесь.
# Docker Compose читает строку `VAR=   # текст` как значение «# текст»: комментарий после пустого
# значения становится самим значением. Именно так комментарий превращался в API-ключ и ломал API.

# --- PostgreSQL: придумайте пароли (латиница и цифры, без пробелов, кавычек, # и $) ---
WS_POSTGRES_SUPERUSER_PASSWORD=change-me
WS_ORCHESTRATOR_DB_PASSWORD=change-me-1
WS_COLLECTOR_DB_PASSWORD=change-me-2
WS_ANALYZER_DB_PASSWORD=change-me-3
WS_INSIGHT_DB_PASSWORD=change-me-4

# --- Внешний API и интерфейс ---
# WS_API_KEY: пусто = аутентификация API отключена (только локальная демонстрация).
# Для стенда жюри задайте случайную строку из латиницы и цифр, например вывод `openssl rand -hex 24`.
WS_API_KEY=
# WS_API_BIND: адрес публикации порта 8080 на хосте. 127.0.0.1 — только локально; 0.0.0.0 — стенд (нужен WS_API_KEY).
WS_API_BIND=127.0.0.1
# WS_UI_BIND: адрес публикации порта 8501 на хосте. Для стенда жюри поставьте 0.0.0.0.
WS_UI_BIND=127.0.0.1
WS_QUEUE_MAX_PENDING=100
WS_WORKER_REPLICAS=1
WS_WORKER_CONCURRENCY=2
WS_INSIGHT_CONCURRENCY=1

# --- Источники ---
# WS_OPENALEX_API_KEY: с 13.02.2026 OpenAlex требует ключ. Бесплатный ключ: https://openalex.org → Sign up → Settings → API key.
# Без ключа адаптер openalex отключается (код AUTH_MISSING), остальные источники продолжают работать.
WS_OPENALEX_API_KEY=
# WS_GITHUB_TOKEN: необязателен; повышает лимит GitHub Search с 10 до 30 запросов в минуту.
WS_GITHUB_TOKEN=
# WS_PATENTSVIEW_API_KEY: не используется — PatentSearch API остановлен с 20.03.2026 (миграция в USPTO ODP).
WS_PATENTSVIEW_API_KEY=
WS_COLLECTOR_RSS_FEEDS=https://techcrunch.com/feed/,https://habr.com/ru/rss/hub/artificial_intelligence/all/,https://www.cnews.ru/inc/rss.xml
# WS_CONTACT_EMAIL: попадает в User-Agent запросов к API источников (правило вежливого клиента).
WS_CONTACT_EMAIL=team@example.org

# --- LLM: заполните хотя бы один провайдер; без ключей выдача будет экстрактивной (статус PARTIAL) ---
# Допустимые провайдеры: gigachat, yandexgpt, none.
WS_LLM_PRIMARY_PROVIDER=gigachat
WS_LLM_FALLBACK_PROVIDER=yandexgpt
# WS_GIGACHAT_CREDENTIALS: Authorization key из кабинета https://developers.sber.ru/studio (проект GigaChat API → Настройки API → Получить ключ).
WS_GIGACHAT_CREDENTIALS=
# WS_GIGACHAT_SCOPE: GIGACHAT_API_PERS — физлицо; GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлицо.
WS_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# WS_GIGACHAT_MODEL: GigaChat-2 (Lite), GigaChat-2-Pro или GigaChat-2-Max — список разрешён ТЗ кейса.
WS_GIGACHAT_MODEL=GigaChat-2-Pro
# WS_GIGACHAT_MAX_CONCURRENCY: физлицо = 1 поток; юрлицо = до 10.
WS_GIGACHAT_MAX_CONCURRENCY=1
# WS_YANDEX_API_KEY / WS_YANDEX_FOLDER_ID: API-ключ сервисного аккаунта с ролью ai.languageModels.user и идентификатор каталога Yandex Cloud.
WS_YANDEX_API_KEY=
WS_YANDEX_FOLDER_ID=
# WS_YANDEX_MODEL: yandexgpt/latest (Pro 5), yandexgpt/rc (Pro 5.1), yandexgpt-lite/latest (Lite 5).
WS_YANDEX_MODEL=yandexgpt/latest

# --- Локальная LLM (необязательно): профиль compose `local-llm`, сервер llama.cpp с GGUF-моделью ---
# Включение: WS_LLM_LOCAL_ENABLED=true и `docker compose --profile local-llm up -d local-llm`.
WS_LLM_LOCAL_ENABLED=false
WS_LOCAL_LLM_BASE_URL=http://local-llm:8000/v1
WS_LOCAL_LLM_GGUF=yandexgpt-5-lite-8b-instruct-q4_k_m.gguf
WS_LOCAL_LLM_THREADS=6

# --- Модель эмбеддингов ---
# WS_HF_HUB_OFFLINE: 1 после первого успешного запуска (кеш e5 прогрет) — демонстрация без сети к HuggingFace.
WS_HF_HUB_OFFLINE=0
WS_MIN_DOC_QUERY_SIM=0.35