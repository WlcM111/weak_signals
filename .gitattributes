# Переводы строк LF во всех текстовых файлах: скрипты запускаются в Linux-контейнерах, и CRLF
# после клонирования на Windows ломал бы их («/bin/sh^M: bad interpreter»).
* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary
*.gz binary
*.joblib binary
*.npz binary
*.pdf binary
# Файлы данных хранятся байт в байт: их хеши записаны в манифестах датасетов, перевод строк менять нельзя.
*.csv -text
